<?xml version="1.0" encoding="UTF-8"?>
<!-- Archivo POM (Project Object Model) de Maven: define como se construye este microservicio, sus dependencias y plugins -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Version del modelo POM que entiende Maven (siempre 4.0.0 en Maven actual) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Proyecto padre: heredamos de Spring Boot la gestion de versiones y configuracion por defecto -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- Identidad de este artefacto: grupo, nombre, version y descripcion del microservicio -->
    <groupId>com.agrosmart</groupId>
    <artifactId>auth-service</artifactId>
    <version>1.0.0</version>
    <name>auth-service</name>
    <description>Microservicio de autenticación con JWT</description>

    <!-- Propiedades reutilizables: version de Java y version de la libreria JWT (jjwt) -->
    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.12.5</jjwt.version>
    </properties>

    <!-- Lista de dependencias (librerias) que necesita compilar y ejecutar el servicio -->
    <dependencies>
        <!-- API REST con Spring MVC -->
        <!-- Permite exponer endpoints HTTP/REST y levanta el servidor web embebido (Tomcat) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistencia con Hibernate (vía Spring Data JPA) -->
        <!-- Mapea objetos Java a tablas de la base de datos y facilita los repositorios -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security: para bcrypt y filtros JWT -->
        <!-- Aporta cifrado de contrasenas (bcrypt) y el marco de seguridad para validar tokens -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validaciones (@Valid) -->
        <!-- Valida automaticamente los datos de entrada de las peticiones con anotaciones -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator: endpoints de salud para Docker healthcheck -->
        <!-- Expone /actuator/health que Docker consulta para saber si el contenedor esta vivo -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Driver de MariaDB -->
        <!-- Conector JDBC para que el servicio se comunique con la base de datos MariaDB -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
        </dependency>

        <!-- JWT (jjwt) -->
        <!-- jjwt-api: interfaz para crear y leer tokens JWT de autenticacion -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <!-- jjwt-impl: implementacion interna de JWT, solo necesaria en tiempo de ejecucion -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- jjwt-jackson: serializa el contenido del token a JSON usando Jackson (solo en ejecucion) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Tests -->
        <!-- Herramientas para pruebas unitarias y de integracion (JUnit, Mockito, etc.); solo en fase de test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Configuracion de la construccion del proyecto -->
    <build>
        <plugins>
            <!-- Plugin de Spring Boot: empaqueta la aplicacion en un JAR ejecutable autocontenido -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
