# ============================================================
# AgroSmart - Variables de entorno
# ============================================================
# Copia este archivo como `.env` (sin el .example) y ajusta
# los valores antes de levantar el sistema con docker compose.
#
#   cp .env.example .env
#
# IMPORTANTE: el archivo .env NUNCA debe subirse a Git.
# ============================================================

# ---------- Conexión a la nube privada (MariaDB master-master) ----------
# Las dos PCs de tu nube. La app se conecta a DB_HOST_1 y, si esa PC se
# apaga, salta automáticamente a DB_HOST_2 (failover). Como ambas son
# master, cualquiera acepta lecturas y escrituras.
# IP del primer nodo de la base de datos (nodo principal)
DB_HOST_1=192.168.1.100
# IP del segundo nodo de la base de datos (nodo de respaldo para failover)
DB_HOST_2=192.168.1.101
# Puerto en el que escucha MariaDB en ambos nodos
DB_PORT=3306
# Nombre de la base de datos del proyecto
DB_NAME=agrosmart
# Usuario con el que las aplicaciones acceden a la base de datos
DB_USER=agrosmart_app
# Contrasena del usuario de la base de datos (cambiar en produccion)
DB_PASSWORD=CambiaEstoEnProd_2026

# ---------- Seguridad - JWT ----------
# Genera una clave larga aleatoria. Mínimo 32 caracteres.
# Puedes usar:  openssl rand -base64 48
# Clave secreta compartida para firmar y validar los tokens JWT
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_al_menos_32_caracteres_2026
# Tiempo de vida del token JWT en milisegundos (3600000 = 1 hora)
JWT_EXPIRATION_MS=3600000    # 1 hora

# ---------- Seguridad - TLS/SSL ----------
# Contraseña del keystore (PKCS12) con el certificado del API Gateway
# Contrasena del keystore que contiene el certificado HTTPS del gateway
SSL_KEYSTORE_PASSWORD=changeit

# ---------- Notificaciones por correo (notification-service / SMTP Gmail) ----------
# MAIL_USERNAME: correo Gmail que envia las alertas.
# MAIL_PASSWORD: "Contraseña de aplicación" de Google (16 caracteres, sin espacios), NO la normal.
#   Se genera en: myaccount.google.com -> Seguridad -> Contraseñas de aplicaciones
# MAIL_TO: destinatario de las alertas.
# NOTIFY_SEVERITIES: severidades que disparan correo (BAJA, MEDIA, ALTA, CRITICA).
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=tu_app_password_de_16_caracteres
MAIL_TO=tucorreo@gmail.com
NOTIFY_SEVERITIES=ALTA,CRITICA
# Minutos de espera entre correos del mismo sensor (anti-spam / evita baneo de Gmail).
NOTIFY_COOLDOWN_MINUTES=30

# ---------- Simulador de sensores (ritmo de generación de lecturas) ----------
# ms entre cada lectura por sensor. Mas alto = menos datos en la BD y menos alertas.
# 5000=5s  30000=30s (recomendado)  60000=1min
SIMULATOR_INTERVAL_MS=30000
