<?xml version="1.0" encoding="UTF-8"?>
<!-- POM de Maven: define como se construye el notification-service, sus dependencias y plugins -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Version del modelo POM (siempre 4.0.0 en Maven actual) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Heredamos de Spring Boot la gestion de versiones y configuracion por defecto -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- Identidad de este microservicio -->
    <groupId>com.agrosmart</groupId>
    <artifactId>notification-service</artifactId>
    <version>1.0.0</version>
    <name>notification-service</name>
    <description>Microservicio de notificaciones: escucha alertas por MQTT y las envía por correo</description>

    <!-- Version de Java usada para compilar y ejecutar -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- Dependencias necesarias -->
    <dependencies>
        <!-- Web: levanta el servidor embebido (lo usa el actuator) y trae Jackson para JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator: expone /actuator/health que Docker consulta para el healthcheck -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Mail: provee JavaMailSender para enviar correos por SMTP (Gmail) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Cliente MQTT Eclipse Paho: para suscribirse al broker Mosquitto y recibir las alertas -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <version>1.2.5</version>
        </dependency>

        <!-- Tests: herramientas de pruebas; solo en fase de test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Construccion: empaqueta en un JAR ejecutable autocontenido -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
